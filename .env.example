# ============================================================
# AI Data Analyst Agent — environment configuration
# Copy this file to backend/.env and fill in the values below.
# ============================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL with pgvector extension enabled) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_data_analyst

# --- LLM provider ---
# One of: openai | anthropic | gemini
LLM_PROVIDER=gemini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings for RAG ---
# Anthropic has no embeddings API, so this is independent from LLM_PROVIDER.
# One of: openai | gemini | local
# "local" runs sentence-transformers on-device: free, no API key, downloads
# the model weights once from the Hugging Face Hub on first use.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observability (optional, LangSmith) ---
# The application works fully without these; leave LANGCHAIN_TRACING_V2=false to disable.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-data-analyst

# --- Security / limits ---
MAX_SQL_ROWS=10000
SQL_TIMEOUT_SECONDS=15
MAX_UPLOAD_SIZE_MB=50
MAX_SQL_FIX_ATTEMPTS=3

# --- Human-in-the-loop ---
CONFIDENCE_THRESHOLD=0.70

# --- Frontend (frontend/.env) ---
# VITE_API_BASE_URL=http://localhost:8000
